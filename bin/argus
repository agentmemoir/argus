"""Run Argus from its source tree, including through an install symlink."""

import os
import sys
from pathlib import Path

args = sys.argv[1:]
driver = Path(__file__).resolve().parents[1] / "phase-driver.sh"
os.execvp("bash", ["bash", str(driver), *args])
