// Argus configuration.
//
//   argus --config /path/to/argus-config.jsonc
//   argus                      // uses ./config.json when it is there
//
// Every relative path below is resolved against the folder that holds THIS
// FILE - not against the working directory and not against any project folder.
// An absolute path is used as written, so a path can point outside the project.
// Move this file and the tree it describes together and the paths still mean
// the same thing.
//
// Comments are allowed. Everything else is strict JSON, so there are no
// trailing commas, and no value has a default: a missing required key stops
// the tick with an error naming the key. No environment variable is read.
//
// A command-line flag beats this file for one run, and the readiness report
// says which of the two supplied each value.

{
  // The project checkout. Required. Relative here, so it is this file's folder
  // plus "project"; use "." for the folder this file sits in.
  "repo-root": "./project",

  // The pipeline file that gets run. Required. Relative to this file.
  "pipeline": "pipeline.yaml",

  // The phases repository: where the work-item files live, and where Argus
  // commits and pushes what it writes there (the index, mainly). Required for
  // the phase source. It is a peer of the board, so it needs its own checkout,
  // branch and remote, and a Git destination different from the board's.
  "phases": {
    // The checkout that owns the phases. Relative here, so it is this file's
    // folder plus "project". A submodule folder works too: name the submodule.
    "repo": "./project",

    // The folder inside that checkout holding the work-item files. Required.
    "directory": "plans",

    // Where Argus commits and pushes the phases. Required. Every machine that
    // writes phases names the same branch and remote, because two branches are
    // two phase sets.
    "branch": "main",
    "remote": "origin"
  },

  // The pipeline input names that carry the work-item number and file. Optional,
  // but a pipeline that declares inputs needs them named.
  "number-input": "phase_number",
  "file-input": "phase_file",

  "driver": {
    // Which work source runs the queue. Required: "phase" for the phases
    // folder, or "issues" for a GitHub issue backlog (see docs/issues.md).
    "provider": "phase",

    // The work-item files to consider, as globs. Required. A list, so more than
    // one shape can be accepted.
    "include": ["phase-*.md"],

    // File names to ignore, matched exactly. Optional.
    "exclude": ["phase-100499.md"],

    // Where run state goes: session logs, the ledger, the receipts. Required.
    // It may sit outside the project. Run state is committed and pushed only
    // when this folder is inside board.repo; here it is under /tmp, so nothing
    // is written into the project.
    "runs": "/tmp/argus/history",

    // The folder inside driver.runs holding the driver's own state: the log,
    // the lock, the halt marker, the pid file. Required. A name, not a path, so
    // the log lands in /tmp/argus/history/driver-state here.
    "state": "driver-state",

    // Seconds without agent output before a run counts as stalled. Required.
    "stale-after": 2700,

    // The longer bound used when a merge check could not answer at all, so a
    // host outage is not reported as a stalled phase. Required.
    "outage-stale": 32400,

    // The notification quiet window, in minutes: no more notices about the same
    // phase inside it. Required.
    "quiet-minutes": 45,

    // Session logs older than this many days are deleted. Required.
    "keep-logs-days": 7,

    // How many published phases one tick checks for a merge before it starts
    // more work. Required.
    "merge-check-max": 5,

    // Whether a tick may take back this host's own claim when its run died.
    // Required. False means only an operator clears such a claim.
    "recover-own-claim": false
  },

  // Which machine this checkout runs as. Required. The value names a file whose
  // first non-empty line is the machine's name; the board records that name as
  // the owner of a claim, so every machine needs its own file and the rest of
  // this configuration can be shared by machines with the same layout.
  "machine": {
    "id-file": "machine.id"
    // Optional: "settings-file" names a small per-machine overlay whose keys
    // replace this file's values (see docs/issues.md).
  },

  // The external commands, named rather than searched for. Required, so nothing
  // is resolved by looking along PATH or by guessing a location. Names are
  // allowed when the caller wants PATH to decide, but they must be written
  // down. hermes is used only when notifications are enabled, and gh only when
  // a board is configured.
  "commands": {
    "glide": "glide",
    "git": "git",
    "tmux": "tmux",
    "python": "/usr/bin/python3",
    "hermes": "hermes",
    "gh": "gh",

    // A command that reads a draft pull request reply on stdin and exits
    // non-zero to refuse it. Optional. An empty string disables the check.
    "reply-check": ""
  },

  // The tmux session the runs happen in. Required when tmux is used to launch.
  "tmux": {
    // The session name. Required.
    "session": "development",

    // The pane geometry, pinned so an attached display cannot resize the agent.
    // Required.
    "width": 164,
    "height": 56,

    // The window that shows status, and the window a run gets. Required.
    "idle-window": "idle",
    "phase-window": "phase",

    // The helper that draws the status window: a file name beside this
    // program's other files, not a path. Required. It is this program's own
    // file, so a project changes it only to replace the status view.
    "idle-script": "phase-tmux-idle.sh",

    // Seconds between status refreshes. Required.
    "refresh": 15
  },

  // The coordination board: a git branch holding this project's claims.
  // Optional as a whole. Omit this object when the project shares no board, and
  // then no reservation is taken and no claim is written.
  "board": {
    // The checkout the board branch lives in. Required with "board". Relative
    // here, so it is this file's folder.
    "repo": ".",

    // The board file's path inside that checkout. Required with "board". An
    // issue machine also names "issues-file", a second file on the same branch.
    "file": "claims.json",

    // The branch the board lives on, and the remote it is pushed to. Required
    // with "board". Every machine that reserves a phase has to name the same
    // branch, because two branches are two boards.
    "branch": "claims",
    "remote": "origin"
  },

  // Notifications. Optional, and machine-local: these values belong to whoever
  // receives them, so this file must not be committed to a public tree.
  "notify": {
    "profile": "example-profile",
    // The whole hermes target: the platform, a colon, and the channel id.
    "channel": "discord:000000000000000000",

    // Whether notices are sent at all. Required when notify is present, so that
    // turning them off is a value in the file rather than an unset variable.
    "disabled": false,

    // A second target used when the first one fails, and a heartbeat URL.
    // Optional. An empty string means: not used.
    "fallback": "",
    "heartbeat": ""
  },

  // Self-healing. Optional as a whole. Omit this object and a pull request whose
  // checks fail is left for a person. With it, a tick that finds checks finished
  // red on a pull request this machine published starts one repair run on that
  // branch, then reads the new checks.
  "repair": {
    // The pipeline a repair run executes: one step that reads the task and fixes
    // the branch. It takes the inputs "repair_id" and "repair_task" and keeps its
    // run folder under the driver's state folder. Required with "repair".
    "pipeline": "repair.yaml",

    // How many repair runs one pull request gets before it is given up. A pull
    // request whose checks pass starts the count again. At least 1. Required
    // with "repair".
    "attempts": 3,

    // Seconds the line waits for the checks of a pull request this machine
    // published to finish before it starts other work, because a result for a
    // head that has been replaced is never seen again. 0 never waits. Required
    // with "repair".
    "wait": 1800
  },

  // Estimate factor. Optional; both keys switch it on. After a phase finishes
  // from a fresh start, the driver sets the developer harness's factor toward
  // phase hours / (ideal days x 2), moving it at most 20% per phase, then
  // commits and pushes the file alone. A resumed run is skipped.
  "estimate": {
    // A JSON file inside a git checkout with an upstream:
    // {"factors": {"<harness id>": 1.0}}. A harness with no factor starts from
    // the slowest one in the file.
    "factors-file": "estimation-factors.json",

    // A command that prints one phase's ideal days; the phase number is added
    // as its last argument. It runs from "repo-root". No number, no update.
    "ideal-days": "python3 tools/ideal_days.py"
  }
}
